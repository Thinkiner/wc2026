# Скопируйте этот файл в .env и заполните своими значениями
# Файл .env НЕ загружается на GitHub (добавьте его в .gitignore)

# Порт сервера (Render сам задаёт PORT, не меняйте)
PORT=3000

# Строка подключения к PostgreSQL
# На Render: скопируйте "Internal Database URL" из настроек базы данных
DATABASE_URL=postgresql://user:password@localhost:5432/wc2026

# Секрет для подписи JWT-токенов — придумайте длинную случайную строку
JWT_SECRET=придумайте-длинный-секретный-ключ-минимум-32-символа

# Email и пароль администратора
ADMIN_EMAIL=admin@wc2026.ru
ADMIN_PASSWORD=admin2026
